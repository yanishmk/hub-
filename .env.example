# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
START_WORKER_IN_PROCESS=true

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cluster_pos_hub?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- Cluster POS ---
CLUSTER_API_KEY="your-cluster-api-key"
CLUSTER_SERIAL="your-cluster-serial-number"
CLUSTER_TOKEN="your-cluster-bearer-token"
CLUSTER_API_BASE_URL="https://api.clusterpos.example.com"
CLUSTER_MAX_RETRIES=3

# --- Website orders ---
WEBSITE_API_KEY="change-me-website-key"

# --- Admin dashboard (/dashboard) ---
ADMIN_API_KEY="change-me-admin-key"

# --- Uber Eats ---
UBEREATS_ENABLED=false
UBEREATS_APP_NAME=""
UBEREATS_CLIENT_ID=""
UBEREATS_CLIENT_SECRET=""
UBEREATS_WEBHOOK_SIGNING_SECRET=""
# Production: https://api.uber.com / https://auth.uber.com/oauth/v2/token
# Sandbox: https://test-api.uber.com / https://sandbox-login.uber.com/oauth/v2/token
UBEREATS_API_BASE_URL="https://api.uber.com"
UBEREATS_AUTH_URL="https://auth.uber.com/oauth/v2/token"
UBEREATS_OAUTH_SCOPE="eats.order"
# If true, the hub calls /accept_pos_order after saving the order.
UBEREATS_AUTO_ACCEPT=false

# --- DoorDash ---
DOORDASH_ENABLED=false
DOORDASH_DEVELOPER_ID=""
DOORDASH_KEY_ID=""
DOORDASH_SIGNING_SECRET=""

# --- Skip the Dishes ---
SKIP_ENABLED=false
SKIP_API_KEY=""
SKIP_WEBHOOK_SIGNING_SECRET=""
